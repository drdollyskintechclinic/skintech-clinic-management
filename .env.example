# Copy to .env for local development. Never commit real credentials or secrets.
DATABASE_URL="postgresql://skintech_app:replace-with-a-local-password@localhost:5432/skintech_clinic?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional: enables a one-time, explicit seed of the first staff administrator.
# Set both values locally; no default password is supplied.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Optional structured log level: debug, info, warn, error
LOG_LEVEL="info"

